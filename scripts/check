#!/bin/sh

set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

luac -p init.lua config.lua modules/*.lua tests/*.lua tests/support/*.lua

# Hammerspoon が読み込むファイルは、Git に含め忘れると別の環境で再現できない。
for file in init.lua config.lua modules/*.lua; do
  if ! git ls-files --error-unmatch "$file" >/dev/null 2>&1; then
    echo "untracked production Lua file: $file" >&2
    exit 1
  fi
done

lua tests/run.lua

echo "Automated Verification passed."
